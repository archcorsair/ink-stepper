{
  "name": "ink-stepper",
  "version": "0.2.2",
  "description": "A step-by-step wizard/stepper component for Ink terminal applications",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "NODE_ENV=production bunup",
    "typecheck": "tsc --noEmit",
    "example": "bun examples/wizard.tsx",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test --only-failures",
    "prepublishOnly": "bun run build",
    "publish:npm": "npm publish",
    "publish:jsr": "bun run build && npx jsr publish",
    "version:patch": "bun pm version patch && bun scripts/sync-versions.ts",
    "version:minor": "bun pm version minor && bun scripts/sync-versions.ts",
    "version:major": "bun pm version major && bun scripts/sync-versions.ts",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview"
  },
  "keywords": [
    "ink",
    "react",
    "cli",
    "terminal",
    "tui",
    "stepper",
    "wizard",
    "onboarding",
    "steps"
  ],
  "author": "archcorsair",
  "license": "MIT",
  "homepage": "https://archcorsair.github.io/ink-stepper/",
  "bugs": "https://github.com/archcorsair/ink-stepper/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archcorsair/ink-stepper.git"
  },
  "sideEffects": [
    "./src/**"
  ],
  "peerDependencies": {
    "ink": "^6.6.0 || ^7.0.0",
    "react": "^19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "bunup": "^0.16.32",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ws": "^8.21.2"
  }
}
